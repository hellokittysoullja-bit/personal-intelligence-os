# Скопируйте в .env и при необходимости отредактируйте.
# .env никогда не коммитится (см. .gitignore, docs/SECURITY.md §5).

NODE_ENV=development

# PostgreSQL — поднимается через `docker compose -f docker/docker-compose.yml up -d`
DATABASE_URL=postgres://pios:pios@localhost:5432/pios

# Уровень логирования Pino: fatal|error|warn|info|debug|trace|silent
LOG_LEVEL=info

# HTTP-порты процессов (apps/web использует свой стандартный порт Next.js — 3000)
API_PORT=3001
WORKER_PORT=3002

# Единственный владелец системы (docs/SECURITY.md §11) — до появления
# аутентификации все запросы обслуживаются от его имени.
OWNER_ID=owner

# Источник, которому разрешён CORS-доступ к API (apps/web).
WEB_ORIGIN=http://localhost:3000

# apps/web: адрес apps/api, виден в браузере (NEXT_PUBLIC_* всегда публичный).
NEXT_PUBLIC_API_URL=http://localhost:3001
