# Скопируйте в .env и при необходимости отредактируйте.
# .env никогда не коммитится (см. .gitignore, docs/SECURITY.md §5).

NODE_ENV=development

# PostgreSQL — поднимается через `docker compose -f docker/docker-compose.yml up -d`
DATABASE_URL=postgres://pios:pios@localhost:5432/pios

# Уровень логирования Pino: fatal|error|warn|info|debug|trace|silent
LOG_LEVEL=info

# HTTP-порты процессов (apps/web использует свой стандартный порт Next.js — 3000)
API_PORT=3001
WORKER_PORT=3002

# Единственный владелец системы. Внешний доступ к API в production защищён
# bearer-токеном, а web-интерфейс — отдельными HTTP Basic credentials.
OWNER_ID=owner

# Источник, которому разрешён CORS-доступ к API (apps/web).
WEB_ORIGIN=http://localhost:3000

# Адрес apps/api для server-side web proxy. Эта переменная не видна браузеру.
PIOS_API_URL=http://localhost:3001
# Production only: случайный секрет не короче 32 символов. Не используйте NEXT_PUBLIC_*.
API_AUTH_TOKEN=
PIOS_API_TOKEN=
# Production only: защищают owner-facing web-интерфейс HTTP Basic authentication.
PIOS_WEB_USERNAME=
PIOS_WEB_PASSWORD=
